{
  "name": "@zfgcta/dsh-multi-folder",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin: secondary working directories for a project. The agent keeps the primary workspace as cwd, gains equal write/exec permissions on configured secondary directories under workspace-write mode, and is notified of configuration changes at the next message boundary. Managed from the composer's own '+' menu (official option picker: add via the native directory picker, remove behind a confirmation), configurable before the first message through a sessionless multiFolder remote API, and referenceable with @ in the input.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "multi-folder",
    "secondary-workspace",
    "workspace"
  ],
  "license": "MIT",
  "author": "Yutong Zou <yutong.zou.24@alumni.ucl.ac.uk> (https://github.com/AngelosZou)",
  "contributors": [
    "HelloQingTao <1470402627@qq.com> (https://github.com/HelloQingTao)"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloQingTao/dsh-multi-folder.git"
  },
  "bugs": {
    "url": "https://github.com/HelloQingTao/dsh-multi-folder/issues"
  },
  "homepage": "https://github.com/HelloQingTao/dsh-multi-folder#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "dsh": {
    "compatibility": {
      "node": ">=20",
      "dshReleases": {
        "0.1.7-rc.2": "compatible",
        "0.1.6-alpha.1": "incompatible",
        "0.1.2-alpha.5": "incompatible",
        "0.1.2-alpha.4": "incompatible",
        "0.1.2-alpha.3": "incompatible",
        "0.1.2-alpha.2": "incompatible",
        "0.1.2-alpha.1": "incompatible",
        "0.1.1-rc.2": "incompatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
